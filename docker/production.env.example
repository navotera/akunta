# Copy this file to docker/production.env and replace all CHANGE_ME values.
# Do not commit docker/production.env.

# GHCR image namespace and tag. Prefer an immutable semver or sha-* tag in prod.
GHCR_NAMESPACE=navotera/akunta
AKUNTA_IMAGE_TAG=latest

# The host reverse proxy should terminate TLS and forward to these ports.
ACCOUNTING_API_BIND=127.0.0.1
ACCOUNTING_API_PORT=8000
ACCOUNTING_WEB_BIND=127.0.0.1
ACCOUNTING_WEB_PORT=8080

# PostgreSQL is provided by another Docker stack on this external network.
# Change both values when your PostgreSQL service/network uses different names.
POSTGRES_NETWORK=homeopensynergic_default
DB_HOST=postgres-db1
DB_PORT=5432

APP_NAME=Akunta
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_A_REAL_LARAVEL_KEY
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://api.accounting.example.com
SPA_URL=https://accounting.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MODE=self_hosted
USE_MAIN_TIER=false
BCRYPT_ROUNDS=12

# Logging to container stdout/stderr.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Shared/control database and tenant database defaults.
DB_CONNECTION=ecosystem_control
DB_DATABASE=ecosystem_control
DB_USERNAME=akunta
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CONTROL_DB_HOST=postgres-db1
CONTROL_DB_PORT=5432
CONTROL_DB_DATABASE=ecosystem_control
CONTROL_DB_USERNAME=akunta
CONTROL_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
TENANT_DB_HOST=postgres-db1
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=akunta
TENANT_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
TENANT_DB_PREFIX=tenant_

# Tenancy and SPA cookies.
TENANT_HEADER=X-Tenant-Slug
TENANT_SUBDOMAIN_ENABLED=true
TENANT_BASE_DOMAIN=accounting.example.com
TENANT_JWT_CLAIM=tenant_id
SANCTUM_STATEFUL_DOMAINS=accounting.example.com,api.accounting.example.com
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.accounting.example.com
SESSION_SECURE_COOKIE=true
SESSION_PATH=/

# Redis is provided by the Compose service named redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=akunta
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail: replace with the production SMTP provider when email is enabled.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Akunta

# Ecopa compatibility overrides. New installs use the first-access wizard and
# receive encrypted client/webhook credentials from Ecopa's approval callback.
ECOPA_URL=https://home.opensynergic.com
ECOPA_CLIENT_ID=
ECOPA_CLIENT_SECRET=
ECOPA_REGISTRATION_NAME=Akunta
ECOPA_REDIRECT_URI=https://api.accounting.example.com/auth/ecopa/callback
ECOPA_API_TOKEN=
ECOPA_EXPECTED_ISSUER=ecopa
ECOPA_JWKS_CACHE_SECONDS=3600
ECOPA_HTTP_TIMEOUT=8
ECOPA_WEBHOOK_SECRET=
AUTH_SSO_AUTO_REGISTER=false

SEED_DEMO_DATA=false
